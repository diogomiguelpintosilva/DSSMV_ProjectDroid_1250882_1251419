<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

    <!-- Zona superior: mapa -->
    <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/painelInferior" />

    <!-- Banner para lembretes (UC11) e avisos de desvio (UC10) -->
    <TextView
            android:id="@+id/tvBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    <!-- Painel inferior: telemetria (UC6) e botões de ação (UC7, UC8, UC9) -->
    <LinearLayout
            android:id="@+id/painelInferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFFFF"
            android:orientation="vertical"
            android:padding="8dp">

        <!-- Linha da Telemetria (Tempo, Velocidade, Altitude) -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

            <!-- Bloco Tempo -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atividade_tempo"
                        android:textColor="#555555" />
                <TextView
                        android:id="@+id/tvTempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <!-- Bloco Velocidade -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atividade_velocidade"
                        android:textColor="#555555" />
                <TextView
                        android:id="@+id/tvVelocidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km/h"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <!-- Bloco Altitude -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atividade_altitude"
                        android:textColor="#555555" />
                <TextView
                        android:id="@+id/tvAltitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 m"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Linha dos Botões de Ação -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">
            <Button
                    android:id="@+id/btnFoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/atividade_foto" />
            <Button
                    android:id="@+id/btnVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/atividade_video" />
            <Button
                    android:id="@+id/btnTerminar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/atividade_terminar" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>